{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "composite": true
  },
  "references": [
    { "path": "apps/api" },
    { "path": "packages/types" }
  ],
  "exclude": ["node_modules"]
}